{
  "name": "lnap-v2",
  "version": "2.0.0",
  "description": "Sistema de traducción de lenguaje natural a C#, Lua, Python y C++ con validación automatizada",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "start": "electron .",
    "validator": "cd validator-service && python app.py",
    "package": "npm run build && electron-builder"
  },
  "keywords": [
    "education",
    "programming",
    "nlp",
    "ollama"
  ],
  "author": "Luis Bernardo Ballesteros Barradas",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.7.9",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.itver.lnap",
    "productName": "LNAP v2",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
